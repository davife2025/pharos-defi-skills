# ─── Pharos RPC ────────────────────────────────────────────────────────────────
# Get your API key from https://zan.top
PHAROS_TESTNET_RPC=https://api.zan.top/node/v1/pharos/testnet/YOUR_API_KEY
# PHAROS_MAINNET_RPC=https://api.zan.top/node/v1/pharos/mainnet/YOUR_API_KEY
PHAROS_FALLBACK_RPC=https://testnet.dplabs-internal.com

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Optional — enables portfolio + price caching and skill call analytics.
# Run docs/migrations/001_cache_schema.sql in your Supabase SQL editor first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# ─── Agent Server ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Optional API key auth — leave unset for open access (local dev).
# When set, all routes except GET /health and GET /skills require this key
# via x-api-key header or Authorization: Bearer <key>.
# AGENT_SERVER_API_KEY=your-secret-api-key-here

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
