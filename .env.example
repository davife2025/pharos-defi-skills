# Pharos RPC — get your API key from https://zan.top
PHAROS_TESTNET_RPC=https://api.zan.top/node/v1/pharos/testnet/YOUR_API_KEY

# Pharos Mainnet (when available)
# PHAROS_MAINNET_RPC=https://api.zan.top/node/v1/pharos/mainnet/YOUR_API_KEY

# Optional: fallback public RPC
PHAROS_FALLBACK_RPC=https://testnet.dplabs-internal.com

# Supabase (used from Session 3+ for caching / analytics)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-key

# Environment
NODE_ENV=development
LOG_LEVEL=info
